{
  "manifest_version": 3,
  "name": "Builder.LI",
  "version": "1.0.0",
  "description": "Score LinkedIn profiles against your ICP and draft personalized connection notes.",
  "permissions": ["activeTab", "storage", "sidePanel", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/in/*",
        "https://www.linkedin.com/sales/lead/*",
        "https://www.linkedin.com/sales/people/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Builder.LI"
  }
}
