{
  "manifest_version": 3,
  "name": "Booking Agent — Nooks Capture",
  "version": "0.1",
  "description": "Send your Nooks call transcript to the Booking Agent so notes are ready when you open it.",
  "permissions": ["activeTab", "storage", "sidePanel", "scripting"],
  "host_permissions": [
    "https://app.nooks.ai/*",
    "https://xdr-hub.netlify.app/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://app.nooks.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Booking Agent — Nooks Capture"
  }
}
