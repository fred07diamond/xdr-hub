# Booking-app-specific secrets. Copy to .env and fill in.
# Workspace-level secrets (BETTER_AUTH_SECRET, APP_URL, WORKSPACE_ORG_*, etc.)
# belong in the root .env — see ../../.env.example.

# Postgres connection string (Neon). Leave blank to fall back to local SQLite.
DATABASE_URL=

# HubSpot private app token (create at app.hubspot.com → Private Apps)
HUBSPOT_ACCESS_TOKEN=

# Google OAuth for Calendar integration
# These live in the workspace root .env if already set there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nooks API key
NOOKS_API_KEY=

# Builder.io keys (for LLM gateway — set in root .env if shared)
BUILDER_PUBLIC_KEY=
BUILDER_PRIVATE_KEY=
