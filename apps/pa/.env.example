# Names only. Real values go in the local .env (ignored) or the framework vault.
#
# Shared workspace settings (DATABASE_URL, BETTER_AUTH_SECRET, A2A_SECRET,
# ANTHROPIC_API_KEY, WORKSPACE_*) come from the workspace root .env. Do not
# redeclare them here.
#
# HubSpot reads use the workspace-shared token (vault key HUBSPOT_ACCESS_TOKEN,
# resolved by @xdr-hub/shared/server). Do not add a second HubSpot token.

# Signed self-call from the webhook intake to the pipeline processor.
PA_INTERNAL_SECRET=
# Developer app client secret that signs HubSpot workflow webhooks (D5).
HUBSPOT_APP_CLIENT_SECRET=
# The separate "PA Inbound" Slack app (D6). Prefixed so it never collides with
# Dispatch's SLACK_BOT_TOKEN / SLACK_SIGNING_SECRET in the root .env.
PA_SLACK_BOT_TOKEN=
PA_SLACK_SIGNING_SECRET=

# Local preview only, never deployed:
# AUTH_DISABLED=1
